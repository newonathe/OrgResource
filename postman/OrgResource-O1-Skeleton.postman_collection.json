{
  "info": {
    "_postman_id": "9fb8cb28-37b9-4b2a-a975-7a564247cc70",
    "name": "OrgResource O1 Java Skeleton",
    "description": "Executable local requests for the O1 five-entity skeleton only. This collection does not claim full lifecycle or all original routes are implemented.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('runSuffix')) { pm.environment.set('runSuffix', String(Date.now())); }"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8080/api" },
    { "key": "runSuffix", "value": "" },
    { "key": "departmentId", "value": "" },
    { "key": "departmentName", "value": "" },
    { "key": "projectId", "value": "" },
    { "key": "resourceId", "value": "" },
    { "key": "requirementId", "value": "" },
    { "key": "allocationId", "value": "" },
    { "key": "deleteDepartmentId", "value": "" },
    { "key": "projectStartAt", "value": "" },
    { "key": "projectEndAt", "value": "" }
  ],
  "item": [
    {
      "name": "1. Create Department",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Department create returns 201', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.environment.set('departmentId', body.id);",
              "pm.environment.set('departmentName', body.name);",
              "pm.test('Department has generated positive ID and normalized name', function () { pm.expect(body.id).to.be.above(0); pm.expect(body.name).to.eql('Postman Logistics ' + pm.environment.get('runSuffix')); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Logistics {{runSuffix}}\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/departments", "host": ["{{baseUrl}}"], "path": ["departments"] }
      }
    },
    {
      "name": "2. List Departments",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Department list returns 200', function () { pm.response.to.have.status(200); });",
        "const rows = pm.response.json();",
        "pm.test('Created Department is visible', function () { pm.expect(rows.some(function (row) { return row.id == pm.environment.get('departmentId'); })).to.eql(true); });"
      ] } }],
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/departments", "host": ["{{baseUrl}}"], "path": ["departments"] } }
    },
    {
      "name": "3. Create Project",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const target = new Date(Date.now() + 3 * 24 * 60 * 60 * 1000 + 8 * 60 * 60 * 1000);",
              "const pad = function (value) { return String(value).padStart(2, '0'); };",
              "const day = target.getUTCFullYear() + '-' + pad(target.getUTCMonth() + 1) + '-' + pad(target.getUTCDate());",
              "pm.environment.set('projectStartAt', day + 'T09:00:00');",
              "pm.environment.set('projectEndAt', day + 'T12:00:00');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Project create returns 201', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.environment.set('projectId', body.id);",
              "pm.test('Project response preserves Department ID and local date strings', function () { pm.expect(body.departmentId).to.eql(Number(pm.environment.get('departmentId'))); pm.expect(body.startAt).to.eql(pm.environment.get('projectStartAt')); pm.expect(body.endAt).to.eql(pm.environment.get('projectEndAt')); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"departmentId\": {{departmentId}},\n  \"name\": \"Postman Orientation {{runSuffix}}\",\n  \"startAt\": \"{{projectStartAt}}\",\n  \"endAt\": \"{{projectEndAt}}\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/projects", "host": ["{{baseUrl}}"], "path": ["projects"] }
      }
    },
    {
      "name": "4. List Projects by Department",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Filtered Project list returns 200', function () { pm.response.to.have.status(200); });",
        "const rows = pm.response.json();",
        "pm.test('Created Project is visible with the correct parent ID', function () { pm.expect(rows.some(function (row) { return row.id == pm.environment.get('projectId') && row.departmentId == pm.environment.get('departmentId'); })).to.eql(true); });"
      ] } }],
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/projects?departmentId={{departmentId}}", "host": ["{{baseUrl}}"], "path": ["projects"], "query": [{ "key": "departmentId", "value": "{{departmentId}}" }] } }
    },
    {
      "name": "5. Create Resource",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Resource create returns 201', function () { pm.response.to.have.status(201); });",
        "const body = pm.response.json();",
        "pm.environment.set('resourceId', body.id);",
        "pm.test('Resource has generated ID and derived availability', function () { pm.expect(body.id).to.be.above(0); pm.expect(body.availableQuantity).to.eql(body.totalQuantity); });",
        "pm.test('No mandatory unit field was added', function () { pm.expect(body).not.to.have.property('unit'); });"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman A4 paper sheets {{runSuffix}}\",\n  \"type\": \"CONSUMABLE\",\n  \"totalQuantity\": 9\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/resources", "host": ["{{baseUrl}}"], "path": ["resources"] }
      }
    },
    {
      "name": "6. List Resources by Type",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Filtered Resource list returns 200', function () { pm.response.to.have.status(200); });",
        "const rows = pm.response.json();",
        "pm.test('Created Resource is visible', function () { pm.expect(rows.some(function (row) { return row.id == pm.environment.get('resourceId'); })).to.eql(true); });"
      ] } }],
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/resources?type=CONSUMABLE", "host": ["{{baseUrl}}"], "path": ["resources"], "query": [{ "key": "type", "value": "CONSUMABLE" }] } }
    },
    {
      "name": "7. Get Resource Availability",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Availability returns 200', function () { pm.response.to.have.status(200); });",
        "const body = pm.response.json();",
        "pm.test('Availability response preserves exactly the two original fields', function () { pm.expect(Object.keys(body).sort()).to.eql(['availableQuantity', 'resourceId']); pm.expect(body.resourceId).to.eql(Number(pm.environment.get('resourceId'))); });"
      ] } }],
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/resources/{{resourceId}}/availability", "host": ["{{baseUrl}}"], "path": ["resources", "{{resourceId}}", "availability"] } }
    },
    {
      "name": "8. Create Requirement",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Requirement create returns 201', function () { pm.response.to.have.status(201); });",
        "const body = pm.response.json();",
        "pm.environment.set('requirementId', body.id);",
        "pm.test('Requirement parent IDs and custom computed query values are correct', function () { pm.expect(body.projectId).to.eql(Number(pm.environment.get('projectId'))); pm.expect(body.resourceId).to.eql(Number(pm.environment.get('resourceId'))); pm.expect(body.allocatedQuantity).to.eql(0); pm.expect(body.shortageQuantity).to.eql(body.quantity); });"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"projectId\": {{projectId}},\n  \"resourceId\": {{resourceId}},\n  \"quantity\": 7\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/requirements", "host": ["{{baseUrl}}"], "path": ["requirements"] }
      }
    },
    {
      "name": "9. List Requirements by Project",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Filtered Requirement list returns 200', function () { pm.response.to.have.status(200); });",
        "const rows = pm.response.json();",
        "pm.test('Created Requirement is visible', function () { pm.expect(rows.some(function (row) { return row.id == pm.environment.get('requirementId'); })).to.eql(true); });"
      ] } }],
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/requirements?projectId={{projectId}}", "host": ["{{baseUrl}}"], "path": ["requirements"], "query": [{ "key": "projectId", "value": "{{projectId}}" }] } }
    },
    {
      "name": "10. Create Allocation",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Allocation create returns 201', function () { pm.response.to.have.status(201); });",
        "const body = pm.response.json();",
        "pm.environment.set('allocationId', body.id);",
        "pm.test('Allocation is pending and redacts phoneNumber', function () { pm.expect(body.requirementId).to.eql(Number(pm.environment.get('requirementId'))); pm.expect(body.status).to.eql('PENDING'); pm.expect(body).not.to.have.property('phoneNumber'); pm.expect(body.contactPresent).to.eql(false); });"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"requirementId\": {{requirementId}},\n  \"quantity\": 2,\n  \"borrowerName\": \"Postman Fictional Representative\",\n  \"smsConsent\": false\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/allocations", "host": ["{{baseUrl}}"], "path": ["allocations"] }
      }
    },
    {
      "name": "11. List Allocations by Requirement and Status",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Filtered Allocation list returns 200', function () { pm.response.to.have.status(200); });",
        "const rows = pm.response.json();",
        "pm.test('Created Allocation persists and remains redacted', function () { const row = rows.find(function (item) { return item.id == pm.environment.get('allocationId'); }); pm.expect(row).to.exist; pm.expect(row).not.to.have.property('phoneNumber'); });"
      ] } }],
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/allocations?requirementId={{requirementId}}&status=PENDING", "host": ["{{baseUrl}}"], "path": ["allocations"], "query": [{ "key": "requirementId", "value": "{{requirementId}}" }, { "key": "status", "value": "PENDING" }] } }
    },
    {
      "name": "12. Reject Normalized Duplicate Department",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Duplicate name returns 409', function () { pm.response.to.have.status(409); });",
        "pm.test('Duplicate error is JSON and uses the expected code', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); pm.expect(pm.response.json().code).to.eql('DUPLICATE_NAME'); });"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"  {{departmentName}}  \"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/departments", "host": ["{{baseUrl}}"], "path": ["departments"] }
      }
    },
    {
      "name": "13. Reject Negative Resource Quantity",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Invalid quantity returns JSON 400', function () { pm.response.to.have.status(400); pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); pm.expect(pm.response.json().code).to.eql('VALIDATION_FAILED'); });"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Invalid Postman Resource {{runSuffix}}\",\n  \"type\": \"CONSUMABLE\",\n  \"totalQuantity\": -1\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/resources", "host": ["{{baseUrl}}"], "path": ["resources"] }
      }
    },
    {
      "name": "14. Create Department for Safe Delete",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Delete fixture Department create returns 201', function () { pm.response.to.have.status(201); });",
        "pm.environment.set('deleteDepartmentId', pm.response.json().id);"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Temporary {{runSuffix}}\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/departments", "host": ["{{baseUrl}}"], "path": ["departments"] }
      }
    },
    {
      "name": "15. Delete Unreferenced Department",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Safe Department delete returns 200', function () { pm.response.to.have.status(200); });",
        "pm.test('Delete success message is JSON', function () { pm.expect(pm.response.json().message).to.eql('Record deleted.'); });"
      ] } }],
      "request": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/departments/{{deleteDepartmentId}}/delete", "host": ["{{baseUrl}}"], "path": ["departments", "{{deleteDepartmentId}}", "delete"] } }
    }
  ]
}
