{
  "info": {
    "name": "OrgResource Expected Failure Contracts",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run after Ordered Demo in same selected environment. Checks refusal behavior; no real SMS. Backend not implemented."
  },
  "item": [
    {
      "name": "Member cannot approve own allocation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Demo-User-Id",
            "value": "{{memberAId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/allocations/{{allocCordAId}}/approve",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expectedVersion\": 0,\n  \"reason\": \"Unauthorized test\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 403',()=>pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "Consumable cannot be returned",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Demo-User-Id",
            "value": "{{custodianId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/allocations/{{allocPaperAId}}/return",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantity\": 1,\n  \"inspection\": \"USABLE\",\n  \"reason\": \"Invalid type test\",\n  \"commandKey\": \"{{$guid}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 409',()=>pm.response.to.have.status(409));",
              "pm.test('Type mismatch',()=>pm.expect(pm.response.json().code).to.eql('RESOURCE_TYPE_MISMATCH'));"
            ]
          }
        }
      ]
    },
