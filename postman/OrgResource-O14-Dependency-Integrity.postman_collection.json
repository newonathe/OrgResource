{
  "info": {
    "_postman_id": "d6a034c3-91dd-4a5b-a1d7-2e8d4356aa14",
    "name": "OrgResource O14 Dependency Integrity",
    "description": "Focused live HTTP acceptance for dependency-protected deletion, unchanged rows after 409, and eligible cleanup. Uses uniquely named fictional records and deletes only the fixtures created in this run.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
        "var supplied=pm.environment.get('runTag');if(supplied){pm.collectionVariables.set('runTag',supplied);}else if(!pm.collectionVariables.get('runTag')){pm.collectionVariables.set('runTag','O14-DI-'+Date.now()+'-'+Math.floor(Math.random()*1000000));}function f(n){return new Date(Date.now()+n*86400000).toISOString().slice(0,19);}pm.collectionVariables.set('startAt',f(30));pm.collectionVariables.set('endAt',f(32));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Create Department fixture",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Department create returns 201',function(){pm.response.to.have.status(201);});var x=pm.response.json();pm.test('Department ID is positive',function(){pm.expect(x.id).to.be.above(0);});pm.collectionVariables.set('departmentId',x.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"O14-DI Department {{runTag}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/departments"
      },
      "response": []
    },
    {
      "name": "02 Create future Project fixture",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Project create returns 201',function(){pm.response.to.have.status(201);});var x=pm.response.json();pm.test('Project belongs to fixture Department',function(){pm.expect(x.departmentId).to.eql(Number(pm.collectionVariables.get('departmentId')));});pm.collectionVariables.set('projectId',x.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"departmentId\":{{departmentId}},\"name\":\"O14-DI Project {{runTag}}\",\"startAt\":\"{{startAt}}\",\"endAt\":\"{{endAt}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/projects"
      },
      "response": []
    },
    {
      "name": "03 Create zero-stock Resource fixture",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Resource create returns 201',function(){pm.response.to.have.status(201);});var x=pm.response.json();pm.test('Resource starts at zero stock',function(){pm.expect(x.totalQuantity).to.eql(0);pm.expect(x.availableQuantity).to.eql(0);});pm.collectionVariables.set('resourceId',x.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"O14-DI Resource {{runTag}}\",\"type\":\"REUSABLE\",\"totalQuantity\":0}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/resources"
      },
      "response": []
    },
    {
      "name": "04 Create Requirement fixture",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Requirement create returns 201',function(){pm.response.to.have.status(201);});var x=pm.response.json();pm.test('Requirement links both fixture parents',function(){pm.expect(x.projectId).to.eql(Number(pm.collectionVariables.get('projectId')));pm.expect(x.resourceId).to.eql(Number(pm.collectionVariables.get('resourceId')));});pm.collectionVariables.set('requirementId',x.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"projectId\":{{projectId}},\"resourceId\":{{resourceId}},\"quantity\":1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/requirements"
      },
      "response": []
    },
    {
      "name": "05 Create never-approved Allocation fixture",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Allocation create returns 201',function(){pm.response.to.have.status(201);});var x=pm.response.json();pm.test('Allocation begins pending without a contact',function(){pm.expect(x.status).to.eql('PENDING');pm.expect(x.phoneNumber).to.eql(undefined);});pm.collectionVariables.set('allocationId',x.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"requirementId\":{{requirementId}},\"quantity\":1,\"borrowerName\":\"O14 fictional fixture {{runTag}}\",\"smsConsent\":false}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/allocations"
      },
      "response": []
    },
