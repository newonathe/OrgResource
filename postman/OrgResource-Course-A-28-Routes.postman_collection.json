            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{imageFile}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('IMAGE-01 expected status 200', function() { pm.response.to.have.status(200); });",
                  "if (pm.response.code===200) { const b=pm.response.json(); pm.test('PNG upload metadata and SHA-256 are valid', function() { pm.expect(b.resourceId).to.eql(Number(pm.environment.get('resourceId'))); pm.expect(b.contentType).to.eql('image/png'); pm.expect(b.sizeBytes).to.be.above(0); pm.expect(b.sha256).to.match(/^[a-f0-9]{64}$/); }); }"
                ]
              }
            }
          ]
        },
        {
          "name": "IMAGE-02 GET /api/resources/{{resourceId}}/image",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "image/png"
              }
            ],
            "url": "{{baseUrl}}/api/resources/{{resourceId}}/image"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('IMAGE-02 expected status 200 and non-empty PNG bytes', function() { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Content-Type')).to.include('image/png'); const length = Number(pm.response.headers.get('Content-Length')); pm.expect(length).to.be.above(0); });",
                  "pm.test('IMAGE-02 response is private-cache-safe', function() { pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'); pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff'); });"
                ]
              }
            }
