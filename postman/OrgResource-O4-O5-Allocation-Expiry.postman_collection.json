    {
      "name": "09 Repeat return is refused",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/allocations/{{reusableAllocationId}}/return"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Repeated return is refused\",function(){pm.response.to.have.status(409);pm.expect(pm.response.json().code).to.eql(\"INVALID_ALLOCATION_STATE\");});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "10 Revoke SMS consent",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/allocations/{{reusableAllocationId}}/revoke-sms-consent"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Consent revoked and contact redacted\",function(){pm.response.to.have.status(200);var x=pm.response.json();pm.expect(x.status).to.eql(\"RETURNED\");pm.expect(x.contactPresent).to.eql(false);pm.expect(x.smsConsent).to.eql(false);pm.expect(x.phoneNumber).to.eql(undefined);});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "11 Repeat consent revocation is idempotent",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/allocations/{{reusableAllocationId}}/revoke-sms-consent"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Repeated revocation succeeds\",function(){pm.response.to.have.status(200);pm.expect(pm.response.json().contactPresent).to.eql(false);});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "12 GET Allocation remains redacted",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/allocations?requirementId={{reusableRequirementId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Contact number never serialized\",function(){pm.response.to.have.status(200);var xs=pm.response.json();var x=xs.find(function(a){return a.id===Number(pm.collectionVariables.get(\"reusableAllocationId\"));});pm.expect(x).to.be.an(\"object\");pm.expect(x.contactPresent).to.eql(false);pm.expect(x.phoneNumber).to.eql(undefined);});"
            ]
          }
        }
      ],
      "response": []
    },
