    {
      "name": "05 Create consented fictional Allocation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/allocations",
        "body": {
          "mode": "raw",
          "raw": "{\"requirementId\":{{reusableRequirementId}},\"quantity\":4,\"borrowerName\":\"O4 Fictional Representative\",\"phoneNumber\":\"+12025550100\",\"smsConsent\":true}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Allocation created pending\",function(){pm.response.to.have.status(201);});var x=pm.response.json();pm.expect(x.status).to.eql(\"PENDING\");pm.collectionVariables.set(\"reusableAllocationId\",x.id);"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "06 Approve reusable Allocation",
