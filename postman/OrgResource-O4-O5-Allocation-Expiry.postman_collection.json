{
  "info": {
    "_postman_id": "31ae0128-d803-4a83-a454-7236ddf839a0",
    "name": "OrgResource O4-O5 Allocation Lifecycle and Expiry",
    "description": "Dynamic-ID HTTP checks for O4 allocation transitions, consent revocation, and guarded history. It creates uniquely named fictional records. Approved, returned, and consumed history is intentionally protected by A08 and remains in the isolated development database. Run only against the OrgResource local development database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if(!pm.collectionVariables.get(\"runTag\")){pm.collectionVariables.set(\"runTag\",Date.now().toString()+Math.floor(Math.random()*10000));}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Create Department fixture",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/departments",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"O4 Demo Department {{runTag}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Department created\",function(){pm.response.to.have.status(201);});var x=pm.response.json();pm.collectionVariables.set(\"departmentId\",x.id);"
            ]
          }
        }
      ],
      "response": []
    },
